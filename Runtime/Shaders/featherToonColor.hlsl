#ifndef FEATHER_TOON_COLOR_INCLUDED
#define FEATHER_TOON_COLOR_INCLUDED

// ═══════════════════════════════════════════════════════════════════════════════════════
// Правка ЦВЕТА ТЕКСТУРЫ, общая для тун-шейдеров: насыщенность и яркость.
//
// Отдельным файлом, а не в featherToonLighting.hlsl: у того в шапке сказано «здесь только
// свет», а это про поверхность. И не копией в каждом шейдере: разъехавшись, одна и та же
// настройка дала бы разный вид у модели и у земли, а заметно это только на их стыке.
//
// Свойств материала не читает — всё приходит параметрами. Поэтому включать можно где
// угодно после Core.hlsl, договора по именам у него нет.
// ═══════════════════════════════════════════════════════════════════════════════════════

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Color.hlsl"

// Считается ДО освещения: текстура правится как картинка, а свет ложится на уже
// поправленную. Единица в обоих — текстура как в файле.
half3 ToonAdjustTextureColor(half3 color, half saturation, half brightness)
{
    half gray = Luminance(color);

    return lerp(gray.xxx, color, saturation) * brightness;
}

#endif
